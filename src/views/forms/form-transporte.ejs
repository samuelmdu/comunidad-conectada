<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Registrar Evento - Comunidad Conectada</title>

    <!-- Remix Icon + Montserrat -->
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.5.0/fonts/remixicon.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;800&display=swap" rel="stylesheet" />
    <!--Header/Footer CSS-->
    <link rel="stylesheet" href="css/global.css">
    <link rel="stylesheet" href="css/forms/form-transporte.css" />
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>

</head>

<body>
    <!-- Header  -->
    <%- include('../components/header.ejs') %>

        <!-- FORMULARIO DE EVENTO -->
        <div class="form">
            <section class="intro">
                <h2>Añadir Transporte</h2>
                <p>
                    Este formulario es para registrar las rutas de transporte público en tu comunidad.
                </p>
            </section>

            <form action="/addRuta" method="POST" class="formEvento" id="formulario">
                <div class="columna1">
                    <!-- GRUPO RUTA -->
                    <div class="formulario-grupo" id="grupo-ruta">
                        <label class="formulario-label">Nombre de la ruta:</label>
                        <div class="formulario-grupo-input">
                            <input type="text" class="formulario-input" name="ruta" id="ruta" required>
                            <i class="formulario-validacion-estado bx bxs-x-circle"></i>
                        </div>
                        <p class="formulario-input-error">
                            La ruta debe tener entre 3 y 45 caracteres. Solo letras y espacios.
                        </p>
                    </div>

                    <!-- GRUPO HORARIO -->
                    <div class="formulario-grupo" id="grupo-horario">
                        <label class="formulario-label">Horario:</label>
                        <div class="formulario-grupo-input">
                            <input type="text" class="formulario-input" name="horario" id="horario"
                                placeholder="Ej: 5:00 AM - 10:00 PM" required>
                            <i class="formulario-validacion-estado bx bxs-x-circle"></i>
                        </div>
                        <p class="formulario-input-error">
                            El horario debe tener el formato “5:00 AM - 10:00 PM”.
                        </p>
                    </div>

                </div>

                <div class="columna2">
                    <div class="formulario-grupo" id="grupo-frecuencia">
                        <label class="formulario-label">Frecuencia (minutos):</label>
                        <div class="formulario-grupo-input">
                            <input type="number" class="formulario-input" name="frecuencia" id="frecuencia" required>
                            <i class="formulario-validacion-estado bx bxs-x-circle"></i>
                        </div>
                        <p class="formulario-input-error">
                            La frecuencia debe ser un número en minutos.
                        </p>
                    </div>

                    <!-- GRUPO PRECIO -->
                    <div class="formulario-grupo" id="grupo-precio">
                        <label class="formulario-label">Precio (₡):</label>
                        <div class="formulario-grupo-input">
                            <input type="number" class="formulario-input" name="precio" id="precio" required>
                            <i class="formulario-validacion-estado bx bxs-x-circle"></i>
                        </div>
                        <p class="formulario-input-error">
                            El precio debe ser un número válido.
                        </p>
                    </div>

                    <p class="notaFinal">
                        Esta ruta será visible para todos los usuarios que naveguen por la página
                    </p>

                    <!-- GRUPO TERMINOS Y CONDICIONES -->
                    <div class="formulario-grupo formulario-grupo-terminos" id="grupo-terminos">
                        <label class="formulario-label">
                            <input type="checkbox" class="formulario-checkbox" name="terminos" id="terminos" required>
                            <b class="formulario-span">Acepto los términos y condiciones</b>
                        </label>
                    </div>

                    <!-- GRUPO DE CAMPOS REQUERIDOS -->
                    <div class="formulario-mensaje" id="formulario-mensaje">
                        <p><i class="bx bxs-ghost"></i> Por favor, completá correctamente todos los campos obligatorios
                            antes de enviar.</p>
                    </div>
                    <p class="formulario-mensaje-exito" id="formulario-mensaje-exito">El formulario se envió
                        correctamente
                    </p>

                    <!-- GRUPO BOTON ENVIAR -->
                    <div class="formulario-grupo" id="formulario-grupo-btn-enviar">
                        <input type="submit" class="formulario-btn" value="Añadir Transporte">
                    </div>
                </div>
            </form>
        </div>

        <!-- Footer  -->
        <%- include('../components/footer.ejs') %>
            <script src="js/forms/form-transporte.js"></script>
            <script src="js/global/menu-responsive.js"></script>
</body>

</html>