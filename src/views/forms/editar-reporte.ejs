<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Comunidad Conectada</title>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.5.0/fonts/remixicon.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="css/global.css">
    <link rel="stylesheet" href="css/forms/form-reporte.css">
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>

</head>

<body>
    <!-- Header  -->
    <%- include('../components/header.ejs') %>

        <!-- FORMULARIO DE REPORTE -->
        <div class="form">
            <section class="intro">
                <h2>Editar reporte <span class="resaltado">— Envía los cambios para revisión</span></h2>
                <p>
                    Modifica los datos del reporte y envía la solicitud. Un administrador revisará los cambios antes de
                    publicarlos.
                </p>
            </section>

            <form action="/actualizar-reporte" method="POST" class="formReporte" id="formulario">
                <!-- ID oculto del reporte original -->
                <input type="hidden" name="id" value="<%= reporte._id %>">

                <div class="columna1">
                    <!-- GRUPO REPORTE -->
                    <div class="formulario-grupo" id="grupo-reporte">
                        <label class="formulario-label">Nombre del reporte:</label>
                        <div class="formulario-grupo-input">
                            <input type="text" required class="formulario-input" name="reporte" id="reporte"
                                placeholder="Robo de señalización vial" value="<%= reporte.reporte %>">
                            <i class="formulario-validacion-estado bx bxs-x-circle"></i>
                        </div>
                        <p class="formulario-input-error">
                            El nombre debe tener entre 4 y 40 caracteres. Solo se permiten letras, números y espacios.
                        </p>
                    </div>

                    <!-- GRUPO TIPO -->
                    <div class="formulario-grupo" id="grupo-tipo">
                        <label class="formulario-label">Tipo de reporte:</label>
                        <div class="formulario-grupo-input">
                            <input type="text" required class="formulario-input" name="tipo" id="tipo"
                                placeholder="Ej: Seguridad, Servicios Públicos, etc." value="<%= reporte.tipo %>">
                            <i class="formulario-validacion-estado bx bxs-x-circle"></i>
                        </div>
                        <p class="formulario-input-error">
                            El tipo debe tener entre 4 y 40 caracteres.
                        </p>
                    </div>

                    <!-- GRUPO DESCRIPCION -->
                    <div class="formulario-grupo" id="grupo-descripcion">
                        <label class="formulario-label">Descripción del reporte:</label>
                        <div class="formulario-grupo-input">
                            <textarea rows="4" required class="formulario-input" name="descripcion" id="descripcion"
                                placeholder="Mientras conducia note que no estaba el Alto no estaba donde correspondia y eso genero un colapso vial"><%= reporte.descripcion %></textarea>
                            <i class="formulario-validacion-estado bx bxs-x-circle"></i>
                        </div>
                        <p class="formulario-input-error">
                            La descripción debe tener entre 10 y 300 caracteres.
                        </p>
                    </div>

                    <!-- GRUPO NOTIFICADO -->
                    <div class="formulario-grupo" id="grupo-notificado">
                        <label class="formulario-label">¿Has notificado esto antes a alguien? ¿A quién?</label>
                        <div class="formulario-grupo-input">
                            <input type="text" required class="formulario-input" name="notificado" id="notificado"
                                placeholder="Ej: Municipalidad, Policía, etc." value="<%= reporte.notificado %>">
                            <i class="formulario-validacion-estado bx bxs-x-circle"></i>
                        </div>
                        <p class="formulario-input-error">
                            Debe contener entre 3 y 100 caracteres.
                        </p>
                    </div>
                </div>

                <div class="columna2">
                    <!-- GRUPO NOMBRE -->
                    <div class="formulario-grupo" id="grupo-nombre">
                        <label class="formulario-label">Tu nombre:</label>
                        <div class="formulario-grupo-input">
                            <input type="text" class="formulario-input" name="nombre" id="nombre"
                                placeholder="Ej: Juan Pérez" value="<%= reporte.nombre %>">
                            <i class="formulario-validacion-estado bx bxs-x-circle"></i>
                        </div>
                        <p class="formulario-input-error">
                            El nombre debe contener entre 4 y 40 caracteres. Solo letras y espacios.
                        </p>
                    </div>

                    <!-- GRUPO CORREO -->
                    <div class="formulario-grupo" id="grupo-correo">
                        <label class="formulario-label">Correo electrónico (para dar seguimiento):</label>
                        <div class="formulario-grupo-input">
                            <input type="email" class="formulario-input" name="correo" id="correo"
                                value="<%= reporte.correo %>">
                            <i class="formulario-validacion-estado bx bxs-x-circle"></i>
                        </div>
                        <p class="formulario-input-error">
                            Debe tener un formato válido: ejemplo@correo.com
                        </p>
                    </div>

                    <!-- GRUPO EVIDENCIA -->
                    <div class="formulario-grupo">
                        <label class="formulario-label">Foto o evidencia del problema:</label>
                        <input type="file" class="formulario-input" accept="image/*" name="image">
                        <% if (reporte.imageUrl) { %>
                            <p class="previewLabel">Evidencia actual:</p>
                            <img src="<%= reporte.imageUrl %>" alt="Evidencia actual" class="preview-file">
                            <% } %>
                    </div>


                    <p class="notaFinal">
                        Al enviar, se creará una solicitud de cambio que un administrador deberá aprobar.
                    </p>


                    <!-- GRUPO TERMINOS Y CONDICIONES -->
                    <div class="formulario-grupo formulario-grupo-terminos" id="grupo-terminos">
                        <label class="formulario-label">
                            <input type="checkbox" class="formulario-checkbox" name="terminos" id="terminos" required>
                            <b class="formulario-span">Acepto los términos y condiciones</b>
                        </label>
                    </div>

                    <!-- GRUPO MENSAJE ERROR -->
                    <div class="formulario-mensaje" id="formulario-mensaje">
                        <p><i class="bx bxs-ghost"></i> Por favor, completá correctamente todos los campos obligatorios
                            antes de enviar.</p>
                    </div>
                    <p class="formulario-mensaje-exito" id="formulario-mensaje-exito">El formulario se envió
                        correctamente
                    </p>



                    <!-- GRUPO BOTON ENVIAR -->
                    <div class="formulario-grupo" id="formulario-grupo-btn-enviar">
                        <input type="submit" class="formulario-btn" value="Guardar cambios">
                    </div>
                </div>
            </form>
        </div>

        <!-- Footer  -->
        <%- include('../components/footer.ejs') %>
            <script src="js/forms/form-reporte.js"></script>
            <script src="js/global/menu-responsive.js"></script>
</body>

</html>