<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Comunidad Conectada</title>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.5.0/fonts/remixicon.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap"
        rel="stylesheet">
    <!--Header/Footer CSS-->
    <link href='https://cdn.boxicons.com/fonts/basic/boxicons.min.css' rel='stylesheet'>

    <link rel="stylesheet" href="css/global.css">
    <link rel="stylesheet" href="css/public-views/publicaciones.css">
</head>

<body>
    <!-- Header  -->
    <%- include('../components/header.ejs') %>

        <main class="main-content">
            <!-- TÍTULO PRINCIPAL -->
            <section class="vertical-content-section">
                <div class="title-container">
                    <h1>Mis publicaciones</h1>
                </div>
            </section>

            <div class="section-divider"></div>

            <!-- EMPRENDIMIENTOS -->
            <section class="vertical-content-section">
                <div class="title-container">
                    <h2>Emprendimientos</h2>
                    <% if (emprendimientos.length===0) { %>
                        <div class="no-created">
                            <p><b>Actualmente no hay publicaciones registradas.</b><br>
                                Vuelve pronto para descubrir nuevas actividades y oportunidades cerca de ti.</p>
                        </div>
                        <% } else { %>
                            <div class="cards-container">
                                <% emprendimientos.forEach(emprendimiento=> { %>
                                    <div class="card">
                                        <div class="card-image chismosa"></div>
                                        <div class="card-text-container">
                                            <p class="card-title">
                                                <%= emprendimiento.nombre %>
                                            </p>
                                            <p class="card-subtitle">
                                                <%= emprendimiento.categoria %>
                                            </p>
                                            <a href="/form-emprendimiento?id=<%= emprendimiento._id %>">
                                                <button class="edit-button">Editar</button>
                                            </a>
                                        </div>
                                    </div>
                                    <% }); %>
                            </div>
                            <% } %>
                </div>
            </section>

            <div class="section-divider"></div>

            <!-- EVENTOS -->
            <section class="vertical-content-section">
                <div class="title-container">
                    <h2>Eventos</h2>
                    <% if (eventos.length===0) { %>
                        <div class="no-created">
                            <p><b>Actualmente no hay publicaciones registradas.</b><br>
                                Vuelve pronto para descubrir nuevas actividades y oportunidades cerca de ti.</p>
                        </div>
                        <% } else { %>
                            <div class="cards-container">
                                <% eventos.forEach(evento=> { %>
                                    <div class="card">
                                        <div class="card-image perros"></div>
                                        <div class="card-text-container">
                                            <p class="card-title">
                                                <%= evento.eventName %>
                                            </p>
                                            <p class="card-subtitle">
                                                <%= evento.direction %>
                                            </p>
                                            <a href="/form-evento?id=<%= evento._id %>">
                                                <button class="edit-button">Editar</button>
                                            </a>
                                        </div>
                                    </div>
                                    <% }); %>
                            </div>
                            <% } %>
                </div>
            </section>

            <div class="section-divider"></div>

            <!-- ANUNCIOS -->
            <section class="vertical-content-section">
                <div class="title-container">
                    <h2>Anuncios</h2>
                    <% if (anuncios.length===0) { %>
                        <div class="no-created">
                            <p><b>Actualmente no hay publicaciones registradas.</b><br>
                                Vuelve pronto para descubrir nuevas actividades y oportunidades cerca de ti.</p>
                        </div>
                        <% } else { %>
                            <div class="cards-container">
                                <% anuncios.forEach(anuncio=> { %>
                                    <div class="route-card-anuncios">
                                        <div class="left-bar"></div>
                                        <div class="card-content-anuncios">
                                            <h3>
                                                <%= anuncio.anuncioName %>
                                            </h3>
                                            <div class="route-details-anuncios">
                                                <p><strong>Descripción:</strong><br>
                                                    <%= anuncio.desciption %>
                                                </p>
                                                <p><strong>Fecha:</strong><br>
                                                    <%= anuncio.date %>
                                                </p>
                                            </div>
                                            <a href="/form-anuncio?id=<%= anuncio._id %>">
                                                <button class="edit-button">Editar</button>
                                            </a>
                                        </div>
                                    </div>
                                    <% }); %>
                            </div>
                            <% } %>
                </div>
            </section>
        </main>

        <footer>
            <!--Copyright-->
            <section class="copyright-container">
                <p>Copyright © TITÍ CODE 2025. All Rights Reserved.</p>
            </section>
        </footer>
        <script src="js/publicaciones/publicaciones.js"></script>
        <script src="js/global/menu-responsive.js"></script>
</body>

</html>