<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Comunidad Conectada</title>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.5.0/fonts/remixicon.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="css/global.css">
    <link rel="stylesheet" href="css/forms/view-reporte.css" />
</head>

<body>
    <!-- Header  -->
    <%- include('../../components/header.ejs') %>
        <div class="form">
            <section class="intro">
                <h2>Vista de Reporte <span class="resaltado">- Panel de Administración</span></h2>
                <p>
                    Estás revisando un reporte enviado por un miembro de la comunidad. Aquí podrás visualizar los
                    detalles
                    completos del caso,
                    verificar la evidencia y tomar una acción según corresponda.
                </p>
                <p>
                    Usá los botones <strong>Aprobar</strong> o <strong>Declinar</strong> al final del reporte para
                    registrar
                    una respuesta.
                </p>
            </section>

            <div class="vistaReporte">
                <input type="hidden" name="id" value="<%= reporte._id %>">
                <!--form class="vistaReporte" action="/viewReporte" method="POST">-->
                <div class="columna1">
                    <label>Nombre del reporte:</label>
                    <p class="dato">
                        <%= reporte.reporte%>
                    </p>

                    <label>Tipo de reporte:</label>
                    <p class="dato">
                        <%= reporte.tipo %>
                    </p>

                    <label>Descripción del reporte:</label>
                    <p class="dato" id="textoGrande">
                        <%= reporte.descripcion %>
                    </p>

                    <label>¿Has notificado esto antes a alguien? ¿A quién?</label>
                    <p class="dato">
                        <%= reporte.notificado %>
                    </p>
                </div>

                <div class="columna2">
                    <label>Nombre del remitente:</label>
                    <p class="dato">
                        <%= reporte.nombre ? reporte.nombre : 'Anónimo' %>
                    </p>

                    <label>Correo electrónico:</label>
                    <p class="dato">
                        <%= reporte.correo %>
                    </p>

                    <label>Foto o evidencia del problema:</label>
                    <img src="../../assets/images/vistasForms/fiesta.jpg" alt="Evidencia del reporte" class="archivo" />

                    <p class="notaFinal">
                        Este reporte fue recibido. El área correspondiente será notificada.
                    </p>

                    <!-- BOTONES DE ACCIÓN -->
                    <div class="acciones-admin">
                        <form action="/admin/approve-ticket" method="POST">
                            <input type="hidden" name="ticketId" value="<%= ticket._id %>">
                            <input type="hidden" name="publicationId" value="<%= reporte._id%>">
                            <input type="hidden" name="type" value="reporte">
                            <button type="submit" class="aprobar">Aprobar</button>
                        </form>

                        <form action="/admin/reject-ticket" method="POST">
                            <input type="hidden" name="ticketId" value="<%= ticket._id %>">
                            <input type="hidden" name="publicationId" value="<%=reporte._id%>">
                            <input type="hidden" name="type" value="reporte">
                            <button type="submit" class="declinar">Rechazar</button>
                        </form>
                    </div>

                </div>
                <!--</form>-->
            </div>

        </div>

        <%- include('../../components/footer.ejs') %>
</body>

</html>