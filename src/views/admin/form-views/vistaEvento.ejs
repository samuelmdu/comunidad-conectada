<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Comunidad Conectada</title>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.5.0/fonts/remixicon.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap"
        rel="stylesheet">
    <!--Header/Footer CSS-->
    <link rel="stylesheet" href="css/global.css">
    <link rel="stylesheet" href="css/forms/view-evento.css" />
</head>

<body>
    <!-- Header  -->

    <%- include('../../components/header.ejs') %> 

        <!-- CONTENIDO PRINCIPAL: Vista Evento -->
        <div class="form">
            <section class="intro">
                <h2>Vista del Evento <span class="resaltado">- Panel de Administración</span></h2>
                <p>
                    Estás revisando un evento comunitario registrado por un miembro de la comunidad.
                    Aquí podrás visualizar todos los detalles ingresados, incluyendo la imagen, contacto y ubicación.
                </p>
                <p>Usá los botones <strong>Aprobar</strong> o <strong>Declinar</strong> al final para tomar una acción.
                </p>
            </section>

            <!--<form class="vistaEvento" action="/viewEvento" method="GET>-->
            <div class="vistaEvento">
                <input type="hidden" name="id" value="<%= evento._id %>">
                <div class="columna1">
                    <label>Nombre del evento:</label>
                    <p class="dato">
                        <%= evento.eventName %>
                    </p>

                    <label>Descripción breve del evento:</label>
                    <p class="dato">
                        <%= evento.description %>
                    </p>

                    <label>Fecha del evento:</label>
                    <p class="dato">
                        <%= evento.date %>
                    </p>

                    <label>Lugar o dirección del evento:</label>
                    <p class="dato">
                        <%= evento.direction %>
                    </p>
                </div>

                <div class="columna2">
                    <label>Persona de contacto (nombre):</label>
                    <p class="dato">
                        <%= evento.creatorName %>
                    </p>

                    <label>Teléfono de contacto:</label>
                    <p class="dato">
                        <%= evento.phone %>
                    </p>

                    <label>Imagen o afiche del evento:</label>
                    <img src="<%= evento.imageUrl %>" alt="Imagen del evento" class="archivo" />

                    <p class="notaFinal">
                        Este evento será evaluado y aprobado si cumple con las políticas de Comunidad Conectada.
                    </p>

                    <!-- <div class="acciones-admin">
                        BOTÓN APROBAR
                        <form action="/aprobar-evento" method="POST">
                            <input type="hidden" name="id" value="<%= evento._id %>">
                            <button type="submit" class="aprobar">Aprobar</button>
                        </form>

                        FORMULARIO PARA DECLINAR 
                        <form action="/eliminar-evento" method="POST">
                            <input type="hidden" name="id" value="<%= evento._id %>">
                            <button type="submit" class="declinar">Declinar</button>
                        </form>-->

                    <div class="acciones-admin">
                        <!-- BOTÓN APROBAR -->
                        <form action="/admin/approve-ticket" method="POST">
                            <input type="hidden" name="ticketId" value="<%= ticket._id %>">
                            <input type="hidden" name="publicationId" value="<%= evento._id %>">
                            <input type="hidden" name="type" value="evento">
                            <button type="submit" class="aprobar">Aprobar</button>
                        </form>

                        <!-- FORMULARIO PARA DECLINAR -->
                        <form action="/admin/reject-ticket" method="POST">
                            <input type="hidden" name="ticketId" value="<%= ticket._id %>">
                            <input type="hidden" name="publicationId" value="<%= evento._id %>">
                            <input type="hidden" name="type" value="evento">
                            <button type="submit" class="declinar">Rechazar</button>
                        </form>
                    </div>
                </div>
            </div>
            <!--</form>-->
        </div>

        <%- include('../../components/footer.ejs') %>
</body>

</html>