<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Comunidad Conectada</title>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.5.0/fonts/remixicon.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="css/global.css">
    <link rel="stylesheet" href="/css/forms/view-emprendimiento.css" />
</head>

<body>
    <!-- Header  -->
    <%- include('../../components/header.ejs') %>

        <div class="form">
            <section class="intro">
                <h2>Vista de Emprendimiento <span class="resaltado">- Panel de Administración</span></h2>
                <p>
                    Estás revisando un emprendimiento registrado por un miembro de la comunidad. Aquí podrás visualizar
                    la
                    información completa del negocio,
                    incluyendo descripción, categoría, contacto y material visual adjunto.
                </p>
                <p>
                    Usá los botones <strong>Aprobar</strong> o <strong>Declinar</strong> al final del reporte para
                    registrar
                    una respuesta.
                </p>
            </section>


            <!--<form class="vistaEmprendimiento">-->
            <div class="vistaEmprendimiento">
                <input type="hidden" name="id" value="<%= emprendimiento._id %>">
                <div class="columna1">
                    <label>Nombre del emprendimiento:</label>
                    <p class="dato"><%=emprendimiento.nombre %> </p>

                    <label>Descripción breve:</label>
                    <p class="dato">
                        <%= emprendimiento.descripcion %>
                    </p>

                    <label>Categorías:</label>
                    <p class="dato">
                        <p class="dato"><%= emprendimiento.categoria %></p>
                    </p>

                    <label>Ubicación:</label>
                    <p class="dato"> 
                        <%= emprendimiento.ubicacion %>
                    </p>

                    <label>Nombre del emprendedor/a:</label>
                    <p class="dato">
                        <%= emprendimiento.emprendedor %>
                    </p>
                </div>

                <div class="columna2">
                    <label>Correo electrónico: </label>
                    <p class="dato">
                        <%= emprendimiento.correo %>
                    </p>

                    <label>Número de teléfono:</label>
                    <p class="dato">
                        <%= emprendimiento.telefono %>
                    </p>

                    <label>Red Social:</label>
                    <p class="dato"><a href="https://instagram.com/cafeescalante" target="_blank">
                        <%= emprendimiento.redSocial %>
                    </a></p>

                    <label>Foto o evidencia del problema:</label>
                    <img src="../../assets/images/cafe.jpg" alt="Evidencia del reporte" class="archivo" />

                    <p class="notaFinal">
                        Este reporte fue recibido. El área correspondiente será notificada.
                    </p>

                    <!-- BOTONES DE ACCIÓN -->
                    <div class="acciones-admin">
                        <form action="/admin/approve-ticket" method="POST">
                            <input type="hidden" name="ticketId" value="<%= ticket._id %>">
                            <input type="hidden" name="publicationId" value="<%= emprendimiento._id %>">
                            <input type="hidden" name="type" value="emprendimiento">
                            <button type="submit" class="aprobar">Aprobar</button>
                        </form>

                        <form action="/admin/reject-ticket" method="POST">
                            <input type="hidden" name="ticketId" value="<%= ticket._id %>">
                            <input type="hidden" name="publicationId" value="<%= emprendimiento._id %>">
                            <input type="hidden" name="type" value="emprendimiento">
                            <button type="submit" class="declinar">Rechazar</button>
                        </form>
                </div>
                </div>
            </div>
            <!--</form>-->

        </div>

        <%- include('../../components/footer.ejs') %>
</body>

</html>