<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Comunidad Conectada</title>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.5.0/fonts/remixicon.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="css/global.css">
    <link rel="stylesheet" href="css/forms/view-emprendimiento.css" />
</head>

<body>
    <!-- Header  -->
    <%- include('../../components/header.ejs') %>

        <div class="form">
            <section class="intro">
                <h2>Vista de Emprendimiento <span class="resaltado">- Panel de Administración</span></h2>
                <p>
                    Estás revisando un emprendimiento registrado por un miembro de la comunidad. Aquí podrás visualizar
                    la
                    información completa del negocio,
                    incluyendo descripción, categoría, contacto y material visual adjunto.
                </p>
                <p>
                    Usá los botones <strong>Aprobar</strong> o <strong>Declinar</strong> al final del reporte para
                    registrar
                    una respuesta.
                </p>
            </section>


            <form class="vistaEmprendimiento">
                <div class="columna1">
                    <label>Nombre del emprendimiento:</label>
                    <p class="dato">Café Escalante</p>

                    <label>Descripción breve:</label>
                    <p class="dato">
                        Un acogedor café local especializado en productos artesanales, repostería casera y cafés de
                        especialidad.
                    </p>

                    <label>Categorías:</label>
                    <p class="dato">
                        Alimentos y bebidas
                    </p>

                    <label>Ubicación:</label>
                    <p class="dato">Barrio Escalante, San José</p>

                    <label>Nombre del emprendedor/a:</label>
                    <p class="dato">Lucía Ramírez</p>
                </div>

                <div class="columna2">
                    <label>Correo electrónico: </label>
                    <p class="dato">lucia.cafe@email.com</p>

                    <label>Número de teléfono:</label>
                    <p class="dato">8888 8888</p>

                    <label>Red Social:</label>
                    <p class="dato"><a href="https://instagram.com/cafeescalante" target="_blank">@cafeescalante</a></p>

                    <label>Foto o evidencia del problema:</label>
                    <img src="../../assets/images/cafe.jpg" alt="Evidencia del reporte" class="archivo" />

                    <p class="notaFinal">
                        Este reporte fue recibido. El área correspondiente será notificada.
                    </p>

                    <!-- BOTONES DE ACCIÓN -->
                    <div class="buttom">
                        <button class="aprobar"> Aprobar</button>
                        <button class="declinar"> Declinar</button>
                    </div>
                </div>
            </form>

        </div>

        <%- include('../../components/footer.ejs') %>
</body>

</html>